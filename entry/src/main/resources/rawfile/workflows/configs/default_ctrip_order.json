{
    "metadata":  {
                     "name":  "basic-gui-task",
                     "description":  "查看携程上的用户全部订单"
                 },
    "defaults":  {
                     "device":  "Harmony",
                     "use_qwen3":  true,
                     "use_e2e":  true,
                     "use_experience":  false,
                     "accept_planner_changes":  false
                 },
    "steps":  [
                  {
                      "id":  1,
                      "type":  "gui_task",
                      "task_description":  "打开携程旅行",
                      "on_error":  "stop"
                  },
                  {
                      "id":  2,
                      "type":  "gui_task",
                      "task_description":  "点击“我的”，进入待付款界面，切换到“全部”标签，查看当前界面的订单",
                      "on_error":  "stop"
                  },
                  {
                      "id":  3,
                      "type":  "gui_action",
                      "action":  "screenshot",
                      "file_name":  "ctrip_order.jpg"
                  },
                  {
                      "id":  4,
                      "type":  "tool",
                      "tool_name":  "vlm_qa",
                      "inputs":  {
                                     "mode":  "summary",
                                     "image":  "${steps.3.output.image_b64}",
                                     "question":  "帮我用一段话简要总结当前页面上的携程全部订单内容（不要使用markdown格式，也不要分点，尽量按照订单出现顺序描述每一单的出行类型、目的地或酒店/车次/航班、时间、金额和订单状态）"
                                 }
                  }
              ]
}
